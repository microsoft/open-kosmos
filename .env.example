# Environment Configuration
# Controls application behavior and logging:production|development
NODE_ENV=development

# Prompt History Configuration
# Maximum number of prompts to keep in history queue
HISTORY_PROMPT_QUEUE_SIZE=20

# CDN Configuration (optional)
# The CDN powers a set of OPTIONAL enhancement features only. When these are
# left unset, the affected features degrade gracefully and the core product
# (creating/configuring agents, chatting, tools/MCP, memory, sub-agents) works
# normally — no default CDN is assumed.
#
# Features that depend on the CDN (all optional):
#   - Agent Library catalog ("Add Agent from Library", first-run promoted agents)
#   - MCP Server Library catalog ("Add MCP from Library")
#   - Skill Library catalog + skill package downloads
#   - App auto-update + native updater binary bootstrap
#   - Chrome native-messaging host download (Browser Control helper)
#   - Default quick-start card image / agent avatar images
#   - Remote setup/update prompt markdown referenced by setup agents
#
# Set these to your own CDN origin to enable the features above.
# DEVELOPMENT_BASE_CDN_URL=
# PRODUCTION_BASE_CDN_URL=

# Remote Channel Relay Service URLs (optional)
# If unset, the app falls back to the built-in defaults for development and production.
# DEVELOPMENT_RELAY_SERVICE_URL=
# PRODUCTION_RELAY_SERVICE_URL=

# Application Insights (optional, development only)
# In development mode, set this variable to override the built-in test environment Connection String, pointing to your own App Insights instance
# In production, the built-in key is always used; this variable has no effect
# APPINSIGHTS_CONNECTION_STRING=

# Active User Tracking
# Active user detection threshold (unit: minutes), default 5 minutes
# Users who continue using the app beyond this duration after launch are recorded as “active users”
# During development/testing, set a smaller value for quick verification, e.g. 0.5 means 30 seconds
ACTIVE_USER_THRESHOLD_MIN=5

# PM Studio Configuration
REDDIT_CLIENT_ID=@OpenKosmos_PM_STUDIO_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=@OpenKosmos_PM_STUDIO_REDDIT_CLIENT_SECRET
DATA_AI_API_KEY=@OpenKosmos_PM_STUDIO_DATA_AI_API_KEY
UNWRAP_ACCESS_TOKEN=@OpenKosmos_PM_STUDIO_UNWRAP_ACCESS_TOKEN
TAVILY_API_KEY=@OpenKosmos_PM_STUDIO_TAVILY_API_KEY