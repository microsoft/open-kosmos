{
  "name": "openkosmos-updater-stub",
  "version": "1.0.0",
  "description": "Lightweight Windows Updater with native UI - NOT an Electron app",
  "main": "dist/stub.js",
  "bin": {
    "openkosmos-updater": "./dist/stub.js"
  },
  "scripts": {
    "build": "tsc",
    "build:exe": "node scripts/build-exe.js",
    "build:all": "npm run build && npm run build:exe",
    "test": "node dist/stub.js --test-ui",
    "clean": "rimraf dist release"
  },
  "keywords": [
    "updater",
    "windows",
    "native-ui",
    "stub"
  ],
  "author": "OpenKosmos Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "pkg": "^5.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-win-arm64"
    ],
    "assets": [
      "scripts/*.ps1"
    ],
    "outputPath": "release"
  }
}
